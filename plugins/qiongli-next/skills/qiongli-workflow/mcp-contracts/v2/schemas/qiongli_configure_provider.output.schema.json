{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/tools/qiongli_configure_provider.output.v2.json",
  "title": "qiongli_configure_provider structured output",
  "type": "object",
  "required": ["status", "url", "host", "port", "config_path"],
  "properties": {
    "status": { "enum": ["ready", "already_running"] },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/\\?token=[^\\s]+$"
    },
    "host": { "const": "127.0.0.1" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "config_path": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["openalex", "semantic_scholar", "crossref", "pubmed"] }
  },
  "additionalProperties": false
}
