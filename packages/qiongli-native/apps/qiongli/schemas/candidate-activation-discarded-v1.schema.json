{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateActivationDiscardedOutput",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1
    },
    "command": {
      "$ref": "#/$defs/ActivationDiscardCommand"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^update-[0-9a-fA-F]{32}$"
    },
    "journal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "transaction_id",
    "journal_sha256"
  ],
  "$defs": {
    "ActivationDiscardCommand": {
      "type": "string",
      "enum": [
        "install-candidate-activate-discard"
      ]
    }
  }
}
