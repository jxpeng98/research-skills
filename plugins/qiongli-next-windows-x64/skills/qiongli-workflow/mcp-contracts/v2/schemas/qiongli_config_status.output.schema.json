{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiongli.dev/schemas/tools/qiongli_config_status.output.v2.json",
  "title": "qiongli_config_status structured output",
  "type": "object",
  "required": [
    "status",
    "config_path",
    "providers",
    "capability_mode",
    "missing",
    "redacted_config"
  ],
  "properties": {
    "status": { "const": "ok" },
    "server": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "config_path": { "type": "string", "minLength": 1 },
    "capability_mode": { "enum": ["provider_connected", "strategy_only"] },
    "providers": { "$ref": "#/$defs/providerSummary" },
    "missing": {
      "type": "array",
      "items": {
        "enum": [
          "openalex.api_key",
          "semantic_scholar.api_key",
          "crossref.email",
          "pubmed.api_key"
        ]
      },
      "uniqueItems": true
    },
    "redacted_config": {
      "type": "object",
      "required": ["providers"],
      "properties": {
        "providers": { "$ref": "#/$defs/redactedProviders" },
        "search": {
          "type": "object",
          "properties": {
            "minimum_productive_providers": { "type": "integer", "minimum": 1 },
            "allow_platform_search_supplement": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "object",
      "required": ["tool", "args", "message"],
      "properties": {
        "tool": { "const": "qiongli_configure_provider" },
        "args": {
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": {
              "enum": ["openalex", "semantic_scholar", "crossref", "pubmed"]
            }
          },
          "additionalProperties": false
        },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "providerSummary": {
      "type": "object",
      "required": ["openalex", "semantic_scholar", "crossref", "pubmed", "arxiv"],
      "properties": {
        "openalex": { "enum": ["configured", "missing"] },
        "semantic_scholar": { "enum": ["configured", "missing"] },
        "crossref": { "enum": ["configured", "missing"] },
        "pubmed": { "enum": ["configured", "missing"] },
        "arxiv": { "enum": ["configured", "missing"] }
      },
      "additionalProperties": false
    },
    "fieldState": { "enum": ["configured", "missing"] },
    "redactedProvider": {
      "type": "object",
      "required": ["enabled", "configured", "fields"],
      "properties": {
        "enabled": { "type": "boolean" },
        "configured": { "type": "boolean" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fieldState" }
        }
      },
      "additionalProperties": false
    },
    "redactedProviders": {
      "type": "object",
      "required": ["openalex", "semantic_scholar", "crossref", "pubmed", "arxiv"],
      "properties": {
        "openalex": { "$ref": "#/$defs/redactedProvider" },
        "semantic_scholar": { "$ref": "#/$defs/redactedProvider" },
        "crossref": { "$ref": "#/$defs/redactedProvider" },
        "pubmed": { "$ref": "#/$defs/redactedProvider" },
        "arxiv": { "$ref": "#/$defs/redactedProvider" }
      },
      "additionalProperties": false
    }
  }
}
