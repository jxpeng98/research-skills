{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdateRecoveryOutput",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 1
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^update-[0-9a-fA-F]{32}$"
        },
        "marker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "$ref": "#/$defs/LegacyRecoveryMode"
        },
        "command": {
          "type": "string",
          "const": "update-recovery-preview"
        }
      },
      "additionalProperties": false,
      "required": [
        "command",
        "schema_version",
        "transaction_id",
        "marker_sha256",
        "mode"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 1
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^update-[0-9a-fA-F]{32}$"
        },
        "marker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "$ref": "#/$defs/LegacyRecoveryMode"
        },
        "command": {
          "type": "string",
          "const": "update-recover"
        }
      },
      "additionalProperties": false,
      "required": [
        "command",
        "schema_version",
        "transaction_id",
        "marker_sha256",
        "mode"
      ]
    }
  ],
  "$defs": {
    "LegacyRecoveryMode": {
      "type": "string",
      "enum": [
        "rollback",
        "committed-cleanup"
      ]
    }
  }
}
