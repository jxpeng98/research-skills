{
  "mcpServers": {
    "qiongli-next": {
      "command": "./bin/qiongli",
      "args": [
        "mcp",
        "serve",
        "--profile",
        "lite",
        "--transport",
        "stdio"
      ],
      "cwd": ".",
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 60
    }
  }
}
